<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <h3 class="col-6 offset-2">Login</h3>
  <div class="col-8 offset-2">
    <form action="/login" method="POST" class="needs-validation" nonvalidate>
      <div class="mb-3">
        <label name="username" class="form-label">Username</label>
        <input
          name="username"
          id="uername"
          type="text"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label name="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-success">Login</button>
    </form>
  </div>
</div>
