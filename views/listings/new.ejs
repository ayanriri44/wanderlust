<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <br />
    <h3>Create a new Listing</h3>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label name="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="enter title"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Title looks good</div>
      </div>
      <div class="mb-3">
        <label name="description" class="form-label">Despriction</label>
        <textarea
          name="listing[description]"
          placeholder="enter description"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Enter Despriction</div>
      </div>
      <div class="mb-3">
        <label name="image" class="form-label">Upload Image</label>
        <input name="listing[image]" type="file" class="form-control" />
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label name="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="enter price"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Enter valid Price</div>
        </div>
        <div class="mb-3 col-md-8">
          <label name="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="enter country"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country should be valid</div>
        </div>
      </div>
      <div class="mb-3">
        <label name="location" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="enter location"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>
      <br />
      <button class="btn btn-dark add-btn mt-3">Add</button>
      <br />
    </form>
  </div>
</div>
