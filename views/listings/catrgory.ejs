<% layout("/layouts/boilerplate") %>

<h3 class="mt-3"><%= title %></h3>
<p class="text-muted"><%= subtitle %></p>

<% if (allListings.length === 0) { %>
  <div class="text-center my-5">
    <p class="lead">No <%= title.toLowerCase() %> listed yet.</p>
    <a href="/listings/new" class="btn btn-dark">Add the first one</a>
  </div>
<% } %>

<div class="row row-cols-lg-4 row-cols-md-2 row-cols-1 mt-2 g-3">
  <% for (let listing of allListings) { %>
    <%- include("../includes/listing-card", { listing }) %>
  <% } %>
</div>