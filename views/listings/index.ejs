<% layout("/layouts/boilerplate") %>

    <style>
  .listing-card .card-img-top {
    width: 100% !important;
    height: 15rem !important;      /* same height for every image */
    object-fit: cover !important;  /* crop instead of stretch */
    display: block;
  }
</style>

<% const sections = [
  { id: "all", title: "All" },
  { id: "homes", title: "Homes", category: "home" },
  { id: "experiences", title: "Experiences", category: "experience" },
  { id: "services", title: "Services", category: "service" }
]; %>

<% for (let sec of sections) { 
  const items = sec.category
    ? allListings.filter(l => l.category === sec.category)
    : allListings; %>

  <section id="<%= sec.id %>">
    <h4 class="mt-2"><%= sec.title %></h4>

    <% if (items.length === 0) { %>
      <p class="text-muted">No listings in this category yet.</p>
    <% } else { %>
      <div class="row row-cols-lg-4 row-cols-md-2 row-cols-1 g-3">
        <% for (let listing of items) { %>
          <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image"  style="height: 15rem; width: 100%; object-fit: cover;"/>
                <div class="card-img-overlay"></div>
                <div class="card-body">
                  <p class="card-text">
                    <b><%= listing.title %> </b><br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                  </p>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>

